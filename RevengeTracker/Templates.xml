<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- The "Recent killers" element on Revenge's settings page and its rows.
         Empty on purpose: ListPanel.lua builds their contents. They exist so the
         settings list and the row scroll box keep Revenge's frames in their own pools. -->
    <Frame name="RevengeTrackerListTemplate" virtual="true">
        <Size x="600" y="328"/>
    </Frame>
    <Frame name="RevengeTrackerListRowTemplate" virtual="true">
        <Size x="560" y="38"/>
    </Frame>
    <!-- The "Other addons" status lines on the settings page (OthersPanel.lua). -->
    <Frame name="RevengeTrackerOthersTemplate" virtual="true">
        <Size x="600" y="76"/>
    </Frame>
    <!-- A kill on the world map (MapPins.lua). The mixin is defined when the map is ready;
         no OnEnter/OnLeave here: the map wires them to OnMouseEnter/OnMouseLeave. -->
    <Frame name="RevengeTrackerKillPinTemplate" mixin="RevengeTrackerKillPinMixin" enableMouse="true" hidden="true" virtual="true">
        <Size x="20" y="20"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon" file="Interface\AddOns\RevengeTracker\Media\Skull" setAllPoints="true"/>
            </Layer>
        </Layers>
    </Frame>
</Ui>
