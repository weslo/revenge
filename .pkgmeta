# Settings for the BigWigs packager (https://github.com/BigWigsMods/packager), which
# builds the release zip and release.json in .github/workflows/build.yml.
#
# The addon lives in RevengeTracker/, so the packager copies the repo into a "Revenge"
# folder, moves RevengeTracker/ out to the top of the zip, and drops the then-empty
# "Revenge" folder. Everything else must be ignored, or it would stay behind in that
# folder and ship as a second, broken addon. tools/check_package.py checks this.
#
# The changelog must be this manual one: a generated changelog would be written into the
# "Revenge" folder and ship too.
#
# No comments after entries: the packager would read them as part of the value.

package-as: Revenge

move-folders:
  Revenge/RevengeTracker: RevengeTracker

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .github
  - .gitignore
  - .luacheckrc
  - CHANGELOG.md
  - README.md
  - docs
  - tests
  - tools
